# Required
BOT_TOKEN=
GROQ_API_KEY=

# Docker only: password for the bundled Postgres (pick any long random string)
POSTGRES_PASSWORD=

# Who can join. Leave both empty to let anyone with the bot link in.
# INVITE_CODE: new users must send /start <code>. Share the link t.me/<bot>?start=<code>
INVITE_CODE=
# ALLOWED_USER_IDS: comma-separated Telegram ids (optional extra lock)
ALLOWED_USER_IDS=

# The address testers open the web app at. Use the tunnel URL when sharing.
PUBLIC_URL=http://localhost:8000

# Optional
# Docker: put your exported cookies at .\cookies\instagram_cookies.txt and keep this line.
# Laptop without Docker: use the Windows path, e.g. C:\dev\rila\cookies\instagram_cookies.txt
INSTAGRAM_COOKIES_PATH=/app/cookies/instagram_cookies.txt
NOMINATIM_USER_AGENT=Rilla/0.1 (your-email@example.com)
WHISPER_MODEL=small
MIN_CONFIDENCE=0.7
# Docker sets DATABASE_URL for you (Postgres + PostGIS + pgvector). Leave it unset in Docker.
# Without Docker the app falls back to SQLite (no PostGIS; search still works, just slower).
# To point at your own Postgres: DATABASE_URL=postgresql://user:password@host:5432/rilla
# RUN_MIGRATIONS=1
