# Required
GROQ_API_KEY=

# Docker only: password for the bundled Postgres (pick any long random string)
POSTGRES_PASSWORD=

# --- Who can use it -------------------------------------------------------------------------
# Web sign-up (no Telegram needed). Closed unless you set one of these:
#   INVITE_CODE=somesecret   people sign up in the web app with this code
#   OPEN_SIGNUP=1            anyone with the address can sign up (only for a private network)
# You can always create your own account with:  docker compose exec api python -m app.cli make-user "Your Name"
INVITE_CODE=
OPEN_SIGNUP=0

# The address testers open the web app at. Use the tunnel URL when sharing.
PUBLIC_URL=http://localhost:8000

# --- Telegram (optional) --------------------------------------------------------------------
# Leave BOT_TOKEN empty to run without Telegram. With it, INVITE_CODE also works as /start <code>.
BOT_TOKEN=
# Comma-separated Telegram ids (optional extra lock)
ALLOWED_USER_IDS=

# --- What Rilla can read --------------------------------------------------------------------
# Video sites accepted as links (anything else: upload the file or paste the text)
# ALLOWED_HOSTS=instagram.com,youtube.com,youtu.be,facebook.com,fb.watch,x.com,twitter.com,tiktok.com
# Speech: model size (tiny, base, small, medium, large-v3). Bigger = more accurate and slower on CPU.
WHISPER_MODEL=small
# Spoken language: empty = detect automatically. Set e.g. kn, hi, ta, te, en to force one.
ASR_LANGUAGE=
# On-screen text languages (tesseract codes). The Docker image has these installed.
OCR_LANGS=eng+hin+kan+tam+tel+mal
OCR_MIN_CONF=60
# Frames looked at per video, longest video accepted, biggest upload
MAX_FRAMES=30
MAX_VIDEO_MINUTES=20
MAX_UPLOAD_MB=200

# --- Optional -------------------------------------------------------------------------------
# Groq models: the first is tried, then the fallbacks if it is retired or rate limited.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Docker: put your exported cookies at .\cookies\instagram_cookies.txt and keep this line.
INSTAGRAM_COOKIES_PATH=/app/cookies/instagram_cookies.txt
# Put your own email here (Nominatim's usage policy asks for a contact).
NOMINATIM_USER_AGENT=Rilla/0.2 (your-email@example.com)
MIN_CONFIDENCE=0.7
# Docker sets DATABASE_URL for you (Postgres + PostGIS + pgvector). Leave it unset in Docker.
# Without Docker the app falls back to SQLite (no PostGIS; search still works, just slower).
# RUN_MIGRATIONS=1

# Speech recognition: auto = Groq Whisper large-v3 if GROQ_API_KEY is set, else local faster-whisper.
# Privacy: with groq/auto the video's audio is sent to Groq. Set local to keep audio on your machine.
ASR_ENGINE=auto
GROQ_ASR_MODEL=whisper-large-v3
# Minimum OCR confidence for non-Latin scripts (higher = fewer junk lines)
OCR_MIN_CONF_NONLATIN=75
